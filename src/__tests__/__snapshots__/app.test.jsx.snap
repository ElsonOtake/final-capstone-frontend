exports[`Testing component rednering propperly renders Login screen 1`] = `
Object {
  "asFragment": [Function],
  "baseElement": <body>
    <div>
      <div
        class="container page-login"
      >
        <form
          action="#"
          class="login-form"
          method="POST"
        >
          <h2>
            LOGIN
          </h2>
          <div
            class="add-padding-below"
          >
            <span
              class="error-message"
            >
              Error with credentials
            </span>
            <input
              class="form-field"
              id="email"
              name="email"
              placeholder="Email"
              required=""
              type="email"
            />
          </div>
          <div
            class="add-padding-below"
          >
            <input
              class="form-field"
              id="password"
              name="password"
              placeholder="Password"
              required=""
              type="password"
            />
          </div>
          <p
            class="signin-message"
          >
            Don't have an account yet?
            <a
              href="/signup"
            >
              SIGN UP
            </a>
          </p>
          <div
            class="form-bottom-bar"
          >
            <button
              class="main color-dark"
              type="button"
            >
              Login
            </button>
          </div>
        </form>
      </div>
    </div>
  </body>,
