Object {
  "asFragment": [Function],
  "baseElement": <body>
    <div>
      <div
        class="container page-admin"
      >
        <div
          class="info-container"
        >
          <h1>
            Add new car
          </h1>
          <form
            method="post"
          >
            <fragment>
              <div
                class="grid-display grid-simple"
              >
                <div
                  class="add-margin-below"
                >
                  <label
                    for="brand"
                  >
                    Brand
                  </label>
                  <input
                    class="form-field"
                    id="brand"
                    name="brand"
                    placeholder="Ferrari"
                    required=""
                    type="text"
                  />
                </div>
              </div>
              <div
                class="grid-display grid-double"
              >
                <div
                  class="add-margin-below"
                >
                  <label
                    for="brand"
                  >
                    Model
                  </label>
                  <input
                    class="form-field"
                    id="model"
                    name="model"
                    placeholder="Testarossa"
                    required=""
                    type="text"
                  />
                </div>
                <div
                  class="add-margin-below grid-double"
                >
                  <label
                    for="year"
                  >
                    Year
                  </label>
                  <input
                    class="form-field"
                    id="year"
                    name="year"
                    placeholder="2018"
                    required=""
                    type="text"
                  />
                </div>
              </div>
              <div
                class="grid-display grid-double"
              >
                <div
                  class="add-margin-below grid-double"
                >
                  <label
                    for="country"
                  >
                    Country
                  </label>
                  <input
                    class="form-field"
                    id="country"
                    name="country"
                    placeholder="Italia"
                    required=""
                    type="text"
                  />
                </div>
                <div
                  class="add-margin-below"
                >
                  <label
                    for="color"
                  >
                    Color
                  </label>
                  <select
                    class="form-field"
                    name="color"
                    required=""
                  >
                    <option
                      value=""
                    >
                      Select one
                    </option>
                    <option
                      value="Black"
                    >
                      Black
                    </option>
                    <option
                      value="Blue"
                    >
                      Blue
                    </option>
                    <option
                      value="Brown"
                    >
                      Brown
                    </option>
                    <option
                      value="Carbon"
                    >
                      Carbon
                    </option>
                    <option
                      value="Green"
                    >
                      Green
                    </option>
                    <option
                      value="Orange"
                    >
