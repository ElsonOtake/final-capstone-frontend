                    </option>
                    <option
                      value="Yellow"
                    >
                      Yellow
                    </option>
                    <option
                      value="White"
                    >
                      White
                    </option>
                  </select>
                </div>
              </div>
              <h3>
                Technical Specs
              </h3>
              <div
                class="grid-display grid-cuadra"
              >
                <div
                  class="add-margin-below"
                >
                  <label
                    for="power"
                  >
                    Power
                  </label>
                  <input
                    class="form-field"
                    id="power"
                    name="power"
                    placeholder="780 CV (574 kW)"
                    required=""
                    type="text"
                  />
                </div>
                <div
                  class="add-margin-below"
                >
                  <label
                    for="maxSpeed"
                  >
